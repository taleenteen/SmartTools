# 2026-05-22: Cloudflare does not pick up functions/@[[slug]].js
# (the whole functions bundle then 1101s and /api/* dies). Deleted that file.
# 200 rewrite keeps /@<slug> in the address bar and reuses functions/u/[[slug]].js.
/@:slug /u/:slug 200

# Do not add `/* /index.html 200` (or any rewrite whose destination is /index.html).
# Workers static assets reject it at deploy (API 100324): default html_handling
# 307s /index.html → / (strips `.html` / `/index`), which matches /* again.
# Vue routes (/ /l /manga /notes /c /settings) are served by wrangler.toml:
#   [assets] not_found_handling = "single-page-application"
# Real files (config.html, about.html, data.js) still win as assets.
